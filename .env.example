# ============================================================
# NovaMoFu (模糊) — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# === Gemini API (必需) ===
# 获取免费 API Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# === Groq API (可选, 用于 Whisper 转写回退) ===
# 获取免费 API Key: https://console.groq.com/keys
GROQ_API_KEY=""

# === 分析引擎选择 ===
# gemini = Gemini 3.1 Pro (推荐, 需要 API Key)
# fallback = ffmpeg + vision_analyze (本地, 不需要 API Key)
NOVAMOFU_ENGINE=gemini

# === Gemini 模型选择 ===
# gemini-3.1-pro-preview = 最高质量
# gemini-3.6-flash = 较快, 免费额度更多 (推荐日常使用)
NOVAMOFU_GEMINI_MODEL=gemini-3.6-flash

# === 输出格式 ===
# seedance = Seedance 2.0 风格
# sora = Sora 风格
# runway = Runway 风格
# generic = 通用风格
NOVAMOFU_OUTPUT_FORMAT=seedance

# === 帧提取设置 (fallback 模式) ===
# 每秒提取帧数 (默认: auto = 短视频10s, 长视频30s)
NOVAMOFU_FRAME_INTERVAL=auto
# 帧质量 (1-31, 越低越好, 默认 3)
NOVAMOFU_FRAME_QUALITY=3
# 帧缩放 (默认 480:-1)
NOVAMOFU_FRAME_SCALE=480:-1

# === 安全 ===
# 允许私有地址访问 (0=关, 1=开, 仅本地测试!)
NOVAMOFU_ALLOW_PRIVATE=0
